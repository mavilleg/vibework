# Library of Babel Configuration

# Application Settings
APP_NAME=Library of Babel
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=*

# Book Configuration
BOOK_PAGES=410
BOOK_LINES_PER_PAGE=40
BOOK_CHARS_PER_LINE=80
ALPHABET=abcdefghijklmnopqrstuvwxyz ,.

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=10000
CACHE_BACKEND=memory  # memory, redis, azure

# Azure Configuration (for production)
# AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
# AZURE_REDIS_CONNECTION_STRING=your-azure-redis-connection-string
# AZURE_BLOB_CONTAINER=books
# AZURE_APP_SERVICE_NAME=your-app-service-name
# AZURE_RESOURCE_GROUP=your-resource-group
# AZURE_SUBSCRIPTION_ID=your-subscription-id

# GitHub Actions Secrets (for CI/CD)
# AZURE_CREDENTIALS={"clientId": "...", "clientSecret": "...", "subscriptionId": "...", "tenantId": "..."}
# AZURE_APP_SERVICE_NAME=your-app-service-name
# AZURE_RESOURCE_GROUP=your-resource-group
# REGISTRY_LOGIN_SERVER=your-registry.azurecr.io
# REGISTRY_USERNAME=your-registry-username
# REGISTRY_PASSWORD=your-registry-password
