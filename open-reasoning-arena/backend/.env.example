# Open Reasoning Arena Configuration
# Copy this file to .env and modify as needed

# Application
APP_NAME="Open Reasoning Arena"
APP_VERSION="0.1.0"
DEBUG=true
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./ora.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_AUTH=false

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT=100/minute
RATE_LIMIT_TASKS=30/minute
RATE_LIMIT_SOLUTIONS=20/minute
RATE_LIMIT_CHALLENGES=15/minute

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type

# Input Validation
MAX_TASK_TITLE_LENGTH=200
MAX_TASK_DESCRIPTION_LENGTH=5000
MAX_SOLUTION_LENGTH=10000
MAX_CHALLENGE_LENGTH=5000
MAX_FEEDBACK_LENGTH=2000

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_BACKEND=memory

# Redis Configuration (for production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# Reputation System
REP_TASK_SUBMISSION=5
REP_SOLUTION_SUBMISSION=3
REP_CHALLENGE_SUBMISSION=10
REP_CHALLENGE_ACCEPTED=15
REP_SCORING=2
REP_SOLUTION_ACCEPTED=5
